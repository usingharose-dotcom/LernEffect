<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <fonts>
    <font name="LernTitle" font-name="Arial" size="18" bold="true"/>
    <font name="LernBody" font-name="Arial" size="10"/>
    <font name="LernSmall" font-name="Arial" size="8"/>
  </fonts>
  <colors>
    <color name="Panel" rgba="#10131BFF"/>
    <color name="Panel2" rgba="#1A202CFF"/>
    <color name="Ice" rgba="#E8F3FFFF"/>
    <color name="Muted" rgba="#8E9AAEFF"/>
    <color name="Blue" rgba="#54C8FFFF"/>
    <color name="Purple" rgba="#A98BFFFF"/>
  </colors>

  <!-- Compact portrait window matching the supplied reference proportions. -->
  <template class="CViewContainer" name="view" origin="0, 0" size="292, 363"
            background-color="Panel" transparent="false" mouse-enabled="true">
    <view class="CTextLabel" origin="16, 10" size="150, 24"
          title="LERN EFFECT" font="LernTitle" text-color="Ice" transparent="true"/>
    <view class="CTextLabel" origin="174, 12" size="102, 18"
          title="VOCAL TUNING" font="LernSmall" text-color="Muted" transparent="true"/>

    <view class="CViewContainer" origin="12, 42" size="268, 104"
          background-color="Panel2" transparent="false">
      <view class="CTextLabel" origin="12, 8" size="240, 18"
            title="PITCH CORRECTION" font="LernBody" text-color="Blue" transparent="true"/>
      <view class="CTextLabel" origin="12, 34" size="78, 16"
            title="RETUNE ms" font="LernSmall" text-color="Muted" transparent="true"/>
      <view class="CSlider" origin="12, 52" size="112, 18"
            control-tag="Retune Speed" min-value="0" max-value="1" default-value="0.25"/>
      <view class="CTextLabel" origin="142, 34" size="78, 16"
            title="AMOUNT" font="LernSmall" text-color="Muted" transparent="true"/>
      <view class="CSlider" origin="142, 52" size="112, 18"
            control-tag="Amount" min-value="0" max-value="1" default-value="1"/>
      <view class="CTextLabel" origin="12, 76" size="78, 16"
            title="DETUNE" font="LernSmall" text-color="Muted" transparent="true"/>
      <view class="CSlider" origin="72, 76" size="182, 18"
            control-tag="Detune" min-value="0" max-value="1" default-value="0.5"/>
    </view>

    <view class="CViewContainer" origin="12, 154" size="268, 104"
          background-color="Panel2" transparent="false">
      <view class="CTextLabel" origin="12, 7" size="240, 17"
            title="KEY &amp; SCALE  •  HOVER KEYS FOR NOTES" font="LernBody"
            text-color="Blue" transparent="true"/>
      <view class="CTextLabel" origin="12, 27" size="80, 14"
            title="ROOT NOTE" font="LernSmall" text-color="Muted" transparent="true"/>
      <view class="CSlider" origin="82, 25" size="66, 16"
            control-tag="Root Note" min-value="0" max-value="1" default-value="0"/>
      <view class="CTextLabel" origin="158, 27" size="58, 14"
            title="SCALE" font="LernSmall" text-color="Muted" transparent="true"/>
      <view class="CSlider" origin="204, 25" size="52" height="16"
            control-tag="Scale Mode" min-value="0" max-value="1" default-value="0"/>

      <view class="COnOffButton" origin="12, 48" size="78, 22"
            control-tag="Chromatic" title="CHROMATIC" default-value="0" min-value="0" max-value="1"/>
      <view class="COnOffButton" origin="98, 48" size="86, 22"
            control-tag="Keep My Scale" title="KEEP SCALE" default-value="1" min-value="0" max-value="1"/>

      <view class="COnOffButton" origin="12, 76" size="18, 22" control-tag="Key C" title="C" default-value="1" min-value="0" max-value="1" tooltip="C"/>
      <view class="COnOffButton" origin="32, 76" size="18, 22" control-tag="Key C#" title="C#" default-value="0" min-value="0" max-value="1" tooltip="C sharp / D flat"/>
      <view class="COnOffButton" origin="52, 76" size="18, 22" control-tag="Key D" title="D" default-value="1" min-value="0" max-value="1" tooltip="D"/>
      <view class="COnOffButton" origin="72, 76" size="18, 22" control-tag="Key D#" title="D#" default-value="0" min-value="0" max-value="1" tooltip="D sharp / E flat"/>
      <view class="COnOffButton" origin="92, 76" size="18, 22" control-tag="Key E" title="E" default-value="1" min-value="0" max-value="1" tooltip="E"/>
      <view class="COnOffButton" origin="112, 76" size="18, 22" control-tag="Key F" title="F" default-value="1" min-value="0" max-value="1" tooltip="F"/>
      <view class="COnOffButton" origin="132, 76" size="18, 22" control-tag="Key F#" title="F#" default-value="0" min-value="0" max-value="1" tooltip="F sharp / G flat"/>
      <view class="COnOffButton" origin="152, 76" size="18, 22" control-tag="Key G" title="G" default-value="1" min-value="0" max-value="1" tooltip="G"/>
      <view class="COnOffButton" origin="172, 76" size="18, 22" control-tag="Key G#" title="G#" default-value="0" min-value="0" max-value="1" tooltip="G sharp / A flat"/>
      <view class="COnOffButton" origin="192, 76" size="18, 22" control-tag="Key A" title="A" default-value="1" min-value="0" max-value="1" tooltip="A"/>
      <view class="COnOffButton" origin="212, 76" size="18, 22" control-tag="Key A#" title="A#" default-value="0" min-value="0" max-value="1" tooltip="A sharp / B flat"/>
      <view class="COnOffButton" origin="232, 76" size="18, 22" control-tag="Key B" title="B" default-value="1" min-value="0" max-value="1" tooltip="B"/>
    </view>

    <view class="CViewContainer" origin="12, 266" size="268, 84"
          background-color="Panel2" transparent="false">
      <view class="CTextLabel" origin="12, 6" size="240, 16"
            title="LIVE SETTINGS" font="LernBody" text-color="Blue" transparent="true"/>
      <view class="CTextLabel" origin="12, 26" size="80, 14"
            title="STABILIZER" font="LernSmall" text-color="Muted" transparent="true"/>
      <view class="CSlider" origin="92, 24" size="162, 16"
            control-tag="Note Stabilizer" min-value="0" max-value="1" default-value="0"/>
      <view class="COnOffButton" origin="12, 50" size="112, 24"
            control-tag="Low Latency" title="LOW LATENCY" default-value="1" min-value="0" max-value="1"/>
      <view class="COnOffButton" origin="136, 50" size="118, 24"
            control-tag="Real-time Mode" title="REAL-TIME" default-value="1" min-value="0" max-value="1"/>
    </view>
  </template>

  <control-tags>
    <control-tag name="Retune Speed" tag="100"/>
    <control-tag name="Detune" tag="101"/>
    <control-tag name="Amount" tag="102"/>
    <control-tag name="Sustain" tag="103"/>
    <control-tag name="Note Stabilizer" tag="104"/>
    <control-tag name="Low Latency" tag="105"/>
    <control-tag name="Real-time Mode" tag="106"/>
    <control-tag name="Root Note" tag="107"/>
    <control-tag name="Scale Mode" tag="108"/>
    <control-tag name="Chromatic" tag="109"/>
    <control-tag name="Pitch Reference" tag="110"/>
    <control-tag name="Doubler Width" tag="111"/>
    <control-tag name="Doubler Mix" tag="112"/>
    <control-tag name="Keep My Scale" tag="113"/>
    <control-tag name="HeatMaps" tag="114"/>
    <control-tag name="Detected Notes" tag="115"/>
    <control-tag name="Key C" tag="116"/>
    <control-tag name="Key C#" tag="117"/>
    <control-tag name="Key D" tag="118"/>
    <control-tag name="Key D#" tag="119"/>
    <control-tag name="Key E" tag="120"/>
    <control-tag name="Key F" tag="121"/>
    <control-tag name="Key F#" tag="122"/>
    <control-tag name="Key G" tag="123"/>
    <control-tag name="Key G#" tag="124"/>
    <control-tag name="Key A" tag="125"/>
    <control-tag name="Key A#" tag="126"/>
    <control-tag name="Key B" tag="127"/>
  </control-tags>
</vstgui-ui-description>
